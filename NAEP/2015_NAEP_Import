#Import into R from Python
NAEP_Summary_2015 <- read.csv("/Users/ozoemenannamadim/PyCharmMiscProject/naep_summary_2015.csv")

#Expand Data Table to expand columns Subject, Grade, and Subgroup 
NAEP_2015_State_Summary <- pivot_wider(NAEP_Summary_2015, names_from = c(Subject, Grade, Subgroup), values_from = c(Mean, Median))

#Prepare Box and Whisker Plots
library(ggplot2)
library(dplyr)

# A. Filter the imported summary file for 4th Grade Math

df_subgroups_4math_2015 <- NAEP_Summary_2015 %>%
  filter(
    Subject == "Mathematics",
    Grade == "4",
    !State %in% c("NT", "NP")  # Exclude national aggregates
  ) %>%
  mutate(
    Mean = as.numeric(Mean),
    Subgroup = factor(Subgroup, levels = c(
      "All", "White", "Black", "Hispanic", 
      "Economically Disadvantaged", "English Language Learners", "SPED"
    ))
  )

# Calculate 4 Grade Math 2015 National Average
nat_mean_math_4_2015 <- NAEP_Summary_2015 %>% 
  filter(State == "NT", Subject == "Mathematics", Grade == "4", Subgroup == "All") %>% 
  pull(Mean) %>% as.numeric()

# 4 Grade Math 2015 Faceted Plot Construction
fig_faceted_subgroups_2015_Math4 <- ggplot(df_subgroups_4math_2015, aes(x = Mean, y = 1, fill = Subgroup)) +
  # Boxplot summary layer
  geom_boxplot(width = 0.3, color = "gray30", outlier.shape = NA, alpha = 0.5) +
  # Individual state jittered points layer (height controls vertical jitter around y = 1)
  geom_jitter(aes(color = Subgroup), height = 0.08, alpha = 0.7, size = 1.5) +
  # Fixed vertical national reference benchmark line
  geom_vline(xintercept = nat_mean_math_4_2015, linetype = "dashed", color = "black", linewidth = 0.6) +
  # Facet into 7 stacked panels with shared X-axis
  facet_wrap(~ Subgroup, ncol = 1, strip.position = "left") +
  scale_x_continuous(limits = c(190, 260), breaks = seq(190, 260, 10)) +
  labs(
    title = "State Score Distributions Across All 7 NAEP Subgroups (Grade 4 Math, 2015)",
    subtitle = "Shared scale (190–260); Dashed line represents National Overall Mean",
    x = "NAEP Mean Score",
    y = ""
  ) +
 
  theme_minimal(base_size = 11) +
  theme(
    strip.text.y.left = element_text(angle = 0, face = "bold", hjust = 1),
    strip.background = element_blank(),
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),
    panel.grid.minor = element_blank(),
    panel.grid.major.y = element_blank(),
    legend.position = "none",
    plot.title = element_text(face = "bold", size = 12)
  )

# Save visualization
ggsave("faceted_NAEPMath42015_subgroup_distributions.png", plot = fig_faceted_subgroups_2015_Math4, width = 8, height = 11, dpi = 300)

