#Combined all NAEP scores broken out by racial demographics into this long pivot file. The resulting file was segmented  on the assessment Subject and grade. Following the segmentation, then the resulting file is pivoted to present racial subgroups as columns, and the achievement gaps are calulated at the jurisdiction level by each racial subgroup. 


All_Combined_NAEP_Scores_By_Race_Scrubbed <- All_Combined_NAEP_Scores_By_Race %>%
  mutate(
    Mean = as.numeric(Mean),
    Mean = na_if(Mean, 999)
  )

#Segmenting the combined data frame for each individual assessment:

All_Math4Combined_NAEP_Scores_By_Race_Scrubbed <- All_Combined_NAEP_Scores_By_Race_Scrubbed %>% filter(Subject =="Mathematics", Grade == 4)
All_Math8Combined_NAEP_Scores_By_Race_Scrubbed <-
All_Combined_NAEP_Scores_By_Race_Scrubbed %>% filter(Subject =="Mathematics", Grade == 8)
All_RLA4Combined_NAEP_Scores_By_Race_Scrubbed <-
All_Combined_NAEP_Scores_By_Race_Scrubbed %>% filter(Subject =="Reading", Grade == 4)
All_RLA8Combined_NAEP_Scores_By_Race_Scrubbed <-
All_Combined_NAEP_Scores_By_Race_Scrubbed %>% filter(Subject =="Reading", Grade == 8)

#All Achievement Gaps Calculated by Racial Demographic 

Math4_Achievement_Gaps_By_Race_Calculated <- All_Math4Combined_NAEP_Scores_By_Race_Scrubbed %>%
  pivot_wider(
    id_cols = c(Jurisdiction, Year),
    names_from = Subgroup,
    values_from = Mean
  ) %>%
  mutate(
    Gap_White_Black = White - Black,
    Gap_White_Hispanic = White - Hispanic,
    Gap_Asian_Black = Asian - Black,
    Gap_Asian_White = Asian - White,
    Gap_Asian_Hispanic = Asian - Hispanic,
    Gap_Hispanic_Black = Hispanic - Black
  )


