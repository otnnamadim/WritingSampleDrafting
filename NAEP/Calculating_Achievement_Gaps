#Pivoting each of the Achievement files to a longer format to present achievement gaps easier for visualisation.

Math4_Achievement_Gaps_By_Race_Calculated_Long <-
Math4_Achievement_Gaps_By_Race_Calculated %>%
  select(
    Jurisdiction,
    Year,
    Gap_White_Black,
    Gap_White_Hispanic,
    Gap_Asian_Black,
    Gap_Asian_White,
    Gap_Asian_Hispanic,
    Gap_Hispanic_Black
  ) %>%
  pivot_longer(
    cols = starts_with("Gap_"),
    names_to = "Gap_Type",
