#Heatmap to compare achievement gap across year.
library(ggplot2)
library(dplyr)

ggplot(
  Math4_Achievement_Gaps_By_Race_Calculated_Long %>%
    filter(Gap_Type == "Gap_White_Hispanic"),
  aes(
    x = factor(Year),
    y = reorder(Jurisdiction, Gap),
    fill = Gap
  )
) +
  geom_tile(color = "white") +
  scale_fill_gradient2(
    midpoint = 0,
    name = "Score Difference"
  ) +
  labs(
    title = "NAEP Grade 4 Mathematics Academic Achievement Gap: Hispanic vs. White",
    subtitle = "State-level differences across assessment years",
    x = "Assessment Year",
    y = "Jurisdiction"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(
      angle = 45,
      hjust = 1
    )
  )


