#This script combines all data tables via left join for the NAEP Statistics

NAEP_Achievement_Statistics_Combined <-
        Baseline_Statistics_State_Level_Detail_2009_2024_Scrubbed_BWH_v2_Final_Population_Wide_Percentiles %>%
            select('Jurisdiction', 'Year', 'Subject', 'Grade', 'Mean_White', 'Mean_Black', 'Mean_Hispanic', 'X25th.Percentile_White', 'X25th.Percentile_Black', 'X25th.Percentile_Hispanic', 'X50th.Percentile_White', 'X50th.Percentile_Black', 'X50th.Percentile_Hispanic', 'X75th.Percentile_White', 'X75th.Percentile_Black', 'X75th.Percentile_Hispanic') %>%

left_join(
        Baseline_Statistics_At_Risk_State_Level_2009_2024_Wide_Percentiles %>%
            select('Jurisdiction', 'Year', 'Subject', 'Grade', 'Mean_Economically Disadvantaged', 'Mean_Not Economically Disadvantaged','X25th.Percentile_Economically Disadvantaged', 'X25th.Percentile_Not Economically Disadvantaged', 'X50th.Percentile_Economically Disadvantaged', 'X50th.Percentile_Not Economically Disadvantaged', 'X75th.Percentile_Economically Disadvantaged', 'X75th.Percentile_Not Economically Disadvantaged'),
