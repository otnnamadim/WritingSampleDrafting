library(tidyverse)

# 1. Reshape long pipeline output into wide format
NAEP_2009_Wide <- NAEP_2009_Summary %>%
  # Fix spaces in Subgroup names to create valid R column names
  mutate(
    Subgroup = case_when(
      Subgroup == "Economically Disadvantaged" ~ "Economically_Disadvantaged",
      Subgroup == "English Language Learners" ~ "English_Language_Learners",
      TRUE ~ Subgroup
    ),
    # Numeric conversions
    Mean = as.numeric(Mean),
    Median = as.numeric(Median)
  ) %>%
  # Pivot Mean and Median into separate columns per metric-subject-grade-subgroup
  pivot_wider(
    id_cols = c(Year, State),
    names_from = c(Subject, Grade, Subgroup),
    values_from = c(Mean, Median),
    names_sep = "_"
  )

