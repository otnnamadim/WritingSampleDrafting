                            in [
                                "White",
                                "Black",
                                "Hispanic",
                            ]
                        ):
                            variable_name = "SDRACE"

                        # ------------------------------------
                        # Query national jurisdiction
                        # ------------------------------------

                        for jurisdiction in JURISDICTIONS:

                            mean_score = fetch_naep_score(
                                year=year,
                                jurisdiction=jurisdiction,
                                subject=subject,
                                grade=grade,
                                subscale=subscale,
                                variable=variable_name,
                                category_idx=category_idx,
                                stattype=STAT_TYPES["Mean"],
                            )

                            # --------------------------------
                            # Write observation
                            # --------------------------------

                            writer.writerow(
                                [
                                    year,
                                    jurisdiction,
                                    subject.capitalize(),
                                    grade,
                                    subgroup_label,
                                    mean_score,
                                ]
                            )

                            logging.info(
                                f"Completed: "
                                f"{year} | "
                                f"{jurisdiction} | "
                                f"{subject.capitalize()} | "
                                f"Grade {grade} | "
                                f"{subgroup_label} | "
                                f"Mean = {mean_score}"
                            )

                            time.sleep(0.05)

    logging.info(
        "NAEP National Data Extraction "
        "Completed Successfully."
    )


