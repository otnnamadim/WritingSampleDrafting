#The purpose of this script is to prepare summary tables of the National statistics for each NAEP assessmenet by filtering out the relevant assessments from each data table.

National_Statistics_Math4 <- bind_rows(
  National_Averages_By_Race %>%
    filter(
      Subject == "Mathematics",
      Grade == "4"
    ),
  
  National_Averages_SPED %>%
    filter(
      Subject == "Mathematics",
      Grade == "4"
    ),
  
  National_Averages_At_Risk %>%
    filter(
      Subject == "Mathematics",
      Grade == "4"
    ),
  
  National_Averages_ELL %>%
    filter(
      Subject == "Mathematics",
      Grade == "4"
    )
)


